# Processed at container start by the official nginx image (envsubst):
#   ${PORT}        -> port to listen on (Cloud Run sets 8080)
#   ${BACKEND_URL} -> where the Express API lives
#                     (http://backend:3001 in Docker Compose,
#                      https://<backend>.run.app on Cloud Run)
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Reverse-proxy API calls to the backend service
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Single-page-app fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
